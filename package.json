{
  "name": "dsh-plugin-profile-sync",
  "version": "0.1.0",
  "description": "Align user-installed DeepSeek Harness plugins across profiles (web <-> desktop) without copying product bundles. 跨 Profile 对齐用户自装插件，不动产品 bundle。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "profile",
    "plugin-sync",
    "electron"
  ],
  "license": "MIT",
  "author": "dsh-plugin-profile-sync contributors",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-profile-sync": "bin/dsh-profile-sync.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/sync-core.d.ts",
      "default": "./lib/sync-core.js"
    },
    "./apply": {
      "types": "./lib/types/apply.d.ts",
      "default": "./lib/apply.js"
    },
    "./cli": {
      "types": "./lib/types/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/**",
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:direct": "node tests/core.test.mjs && node tests/apply.test.mjs && node tests/cli.test.mjs && node tests/host.test.mjs",
    "sync:check": "node bin/dsh-profile-sync.js --check",
    "sync:preview": "node bin/dsh-profile-sync.js",
    "pack:check": "node scripts/check-pack.mjs",
    "pack:install-check": "node scripts/check-install.mjs",
    "release:stamp": "node scripts/release-stamp.mjs",
    "release:check": "node --test tests/*.test.mjs && node scripts/check-pack.mjs && node scripts/check-install.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wu-Fankai/DSH--.git"
  },
  "bugs": {
    "url": "https://github.com/Wu-Fankai/DSH--/issues"
  },
  "homepage": "https://github.com/Wu-Fankai/DSH--#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
